{
  "_comment": "Shared by the Python and JavaScript test suites. Values are worked out by hand from the official calendar, not generated by either implementation.",
  "is_business_day": [
    { "date": "2026-03-18", "expect": true },
    { "date": "2026-03-19", "expect": true, "note": "Ramazan arifesi, morning is worked" },
    { "date": "2026-03-19", "options": { "half_days": "holiday" }, "expect": false },
    { "date": "2026-03-19", "options": { "half_days": "half" }, "expect": true },
    { "date": "2026-03-20", "expect": false },
    { "date": "2026-10-28", "expect": true },
    { "date": "2026-10-29", "expect": false },
    { "date": "2026-03-07", "expect": false, "note": "Saturday" },
    { "date": "2026-03-07", "options": { "saturday_is_workday": true }, "expect": true },
    { "date": "2026-03-08", "options": { "saturday_is_workday": true }, "expect": false },
    { "date": "2016-07-15", "expect": true, "note": "15 July became a holiday in 2017" },
    { "date": "2019-07-15", "expect": false },
    { "date": "2026-05-25", "options": { "extra_holidays": ["2026-05-25"] }, "expect": false },
    { "date": "2026-03-21", "options": { "extra_workdays": ["2026-03-21"] }, "expect": true }
  ],
  "holiday_key": [
    { "date": "2026-03-20", "expect": "ramazan_1" },
    { "date": "2026-10-28", "expect": "cumhuriyet_arifesi" },
    { "date": "2023-04-23", "expect": "ramazan_3", "note": "overlaps 23 Nisan" },
    { "date": "2011-08-30", "expect": "ramazan_1", "note": "overlaps Zafer Bayramı" },
    { "date": "2033-01-01", "options": { "allow_estimated": true }, "expect": "yilbasi", "note": "full day wins over the arife on the same date" },
    { "date": "2026-03-18", "expect": null }
  ],
  "add_business_days": [
    { "date": "2026-03-18", "n": 1, "expect": "2026-03-19" },
    { "date": "2026-03-18", "n": 2, "expect": "2026-03-23" },
    { "date": "2026-03-18", "n": 1, "options": { "half_days": "holiday" }, "expect": "2026-03-23" },
    { "date": "2026-03-23", "n": -1, "expect": "2026-03-19" },
    { "date": "2026-03-21", "n": 0, "expect": "2026-03-23" },
    { "date": "2026-03-18", "n": 0, "expect": "2026-03-18" },
    { "date": "2026-05-22", "n": 1, "expect": "2026-05-25" },
    { "date": "2026-05-22", "n": 2, "expect": "2026-05-26" },
    { "date": "2026-05-22", "n": 3, "expect": "2026-06-01" },
    { "date": "2026-03-06", "n": 1, "options": { "saturday_is_workday": true }, "expect": "2026-03-07" }
  ],
  "business_days_between": [
    { "start": "2026-03-01", "end": "2026-04-01", "expect": 21 },
    { "start": "2026-04-01", "end": "2026-03-01", "expect": -21 },
    { "start": "2026-03-10", "end": "2026-03-10", "expect": 0 },
    { "start": "2026-03-01", "end": "2026-04-01", "options": { "half_days": "half" }, "expect": 20.5 },
    { "start": "2026-03-01", "end": "2026-04-01", "options": { "half_days": "holiday" }, "expect": 20 },
    { "start": "2026-01-01", "end": "2027-01-01", "expect": 251, "note": "261 weekdays minus 10 weekday holidays" },
    { "start": "2026-01-01", "end": "2027-01-01", "options": { "half_days": "half" }, "expect": 249.5 },
    { "start": "2026-01-01", "end": "2027-01-01", "options": { "half_days": "holiday" }, "expect": 248 }
  ],
  "deadline": [
    { "date": "2026-03-12", "days": 7, "expect": "2026-03-19" },
    { "date": "2026-03-13", "days": 7, "expect": "2026-03-23" },
    { "date": "2026-08-23", "days": 7, "expect": "2026-08-31" }
  ],
  "bridge_days": [
    { "year": 2026, "expect": ["2026-01-02", "2026-04-24", "2026-05-18", "2026-10-30"] },
    { "year": 2026, "options": { "half_days": "holiday" }, "expect": ["2026-01-02", "2026-04-24", "2026-05-18", "2026-05-25", "2026-10-30"] }
  ],
  "holiday_count": [
    { "year": 2026, "expect": 17 },
    { "year": 2016, "expect": 16 },
    { "year": 2033, "options": { "allow_estimated": true }, "expect": 21 }
  ],
  "out_of_range": [
    { "date": "2009-12-31" },
    { "date": "2033-03-11" },
    { "date": "2051-01-02", "options": { "allow_estimated": true } }
  ]
}
