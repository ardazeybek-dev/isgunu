{
  "name": "@ardazeybek-dev/isgunu",
  "version": "0.1.0",
  "description": "Turkish public holidays with arife half days, Diyanet bayram dates and business-day arithmetic: add working days, count them, legal deadlines, bridge days. No dependencies.",
  "keywords": [
    "turkey",
    "turkish",
    "turkiye",
    "holidays",
    "resmi-tatil",
    "is-gunu",
    "business-days",
    "working-days",
    "bayram",
    "arife",
    "calendar"
  ],
  "license": "MIT",
  "author": "Seyid Arda Zeybek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardazeybek-dev/isgunu.git",
    "directory": "js"
  },
  "homepage": "https://github.com/ardazeybek-dev/isgunu#readme",
  "bugs": {
    "url": "https://github.com/ardazeybek-dev/isgunu/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^3.2.7"
  }
}
